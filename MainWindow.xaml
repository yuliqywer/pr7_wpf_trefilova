<Window x:Class="pr7_trefilova.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pr7_trefilova"
        xmlns:models="clr-namespace:pr7_trefilova.Models"
        xmlns:converters="clr-namespace:pr7_trefilova.Converters"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <models:CafeOrder x:Key="order" />
        <converters:SerPerCon x:Key="serPerCon" />
        <converters:TotPriStr x:Key="totPriStr" />
    </Window.Resources>

    <Window.DataContext>
        <Binding Source="{StaticResource order}" />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="10">
            <Label Content="Название блюда:"/>
            <TextBox Text="{Binding DishName, UpdateSourceTrigger=PropertyChanged, ConverterCulture=ru-RU}" Margin="0,0,0,10"/>

            <Label Content="Цена за единицу (руб):"/>
            <TextBox Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged, ConverterCulture=ru-RU}" Margin="0,0,0,10"/>

            <Label Content="Количество:"/>
            <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, ConverterCulture=ru-RU}" Margin="0,0,0,10"/>

            <Label Content="Обслуживание (%):"/>
            <TextBox Text="{Binding ServicePercent, Converter={StaticResource serPerCon}, UpdateSourceTrigger=PropertyChanged, ConverterCulture=ru-RU}" Margin="0,0,0,10"/>

            <Button Content="Очистить всё" Name="ClearButton" Click="ClearButton_Click" Margin="0,30,0,0" Padding="10" Height="35"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="10">
            <Label Content="Название блюда:"/>
            <TextBlock Text="{Binding DishName}" FontWeight="Bold" Margin="0,0,0,10"/>

            <Label Content="Цена за единицу:"/>
            <TextBlock Text="{Binding UnitPrice, StringFormat={}{0:C}, ConverterCulture=ru-RU}" Margin="0,0,0,10"/>

            <Label Content="Количество:"/>
            <TextBlock Text="{Binding Quantity}" Margin="0,0,0,10"/>

            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ServicePercent}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Label Content="Обслуживание (%):"/>
                <TextBlock Text="{Binding ServicePercent, StringFormat={}{0:P0}}" Margin="0,0,0,10"/>
            </StackPanel>

            <Label Content="Итоговая стоимость (с учетом обслуживания):"/>
            <TextBlock Text="{Binding TotalPrice, StringFormat={}{0:C}, ConverterCulture=ru-RU}" 
           FontSize="16"
           FontWeight="{Binding ServicePercent, Converter={StaticResource totPriStr}}"/>
        </StackPanel>
    </Grid>
</Window>
